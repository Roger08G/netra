{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netra.local/schemas/snmpv3-config.schema.json",
  "title": "Netra SNMPv3 read-only configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "timeout_ms",
          "retries",
          "username",
          "auth_protocol",
          "auth_passphrase_env",
          "privacy_protocol",
          "privacy_passphrase_env"
        ],
        "properties": {
          "address": {"type": "string", "format": "ipv4"},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 161},
          "timeout_ms": {"type": "integer", "minimum": 250, "maximum": 10000},
          "retries": {"type": "integer", "minimum": 0, "maximum": 3},
          "username": {"type": "string", "minLength": 1},
          "auth_protocol": {"enum": ["SHA", "SHA224", "SHA256", "SHA384", "SHA512"]},
          "auth_passphrase_env": {"type": "string", "pattern": "^NETRA_SNMP_[A-Z0-9_]+$"},
          "privacy_protocol": {"const": "AES"},
          "privacy_passphrase_env": {"type": "string", "pattern": "^NETRA_SNMP_[A-Z0-9_]+$"},
          "context_name": {"type": "string", "default": ""}
        }
      }
    }
  }
}
